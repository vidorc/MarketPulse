# ---- App ----
APP_NAME=MarketPulse
ENV=dev
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql+psycopg://marketpulse:marketpulse@localhost:5432/marketpulse

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ---- Security ----
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- LLM ----
# provider: groq | mock
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_MAX_CHARS=1200
LLM_REQUEST_DELAY_SECONDS=3.0
LLM_MAX_RETRIES=5
# Real LLM calls only fire when this is true (tests/dev default to mock-safe).
ALLOW_REAL_LLM=false

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads

# ---- Seeding ----
NSE_COMPANIES_CSV=./app/seeds/data/nse_companies.csv
